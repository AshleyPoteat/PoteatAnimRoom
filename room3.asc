// room script file

function room_FirstLoad()
{
cSlime.Animate(0, 9, eRepeat,  eNoBlock);
cBroom.Animate(0, 5, eRepeat,  eNoBlock);
}




function oPearl_Interact(Object *theObject, CursorMode mode)
{
cEgo.Walk(100, 150, eBlock, eWalkableAreas);
cEgo.FaceDirection(eDirectionLeft);
//cEgo.LockView(5);
//cEgo.Animate(0, 5, eOnce, eBlock, eBackwards);
//cEgo.UnlockView();
oPearl.Visible=false;
Display("You picked up a white pearl.");
cEgo.AddInventory(iPearl);

}

function oCoin_Interact(Object *theObject, CursorMode mode)
{
cEgo.Walk(78, 152, eBlock, eWalkableAreas);
cEgo.FaceDirection(eDirectionLeft);
//cEgo.LockView(5);
//cEgo.Animate(0, 5, eOnce, eBlock, eBackwards);
//cEgo.UnlockView();
