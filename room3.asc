// room script file

function room_FirstLoad()
{
cSlime.Animate(0, 9, eRepeat,  eNoBlock);
cBroom.Animate(0, 5, eRepeat,  eNoBlock);
cRed.Animate(0, 13, eRepeat, eNoBlock);
cGreen.Animate(0, 14, eRepeat, eNoBlock);
cPurple.Animate(0, 11, eRepeat, eNoBlock);
cBlue.Animate(0, 12, eRepeat, eNoBlock);
cCauldron.Animate(0, 6, eRepeat, eNoBlock);
cMask.Animate(0, 17, eRepeat, eNoBlock);
cCandle.Animate(0, 18, eRepeat, eNoBlock);
}




function oPearl_Interact(Object *theObject, CursorMode mode)
{
cEgo.Walk(67, 320, eBlock, eWalkableAreas);
cEgo.FaceDirection(eDirectionLeft);
//cEgo.LockView(5);
//cEgo.Animate(0, 5, eOnce, eBlock, eBackwards);
//cEgo.UnlockView();
oPearl.Visible=false;
Display("You picked up a white pearl.");
cEgo.AddInventory(iPearl);

}

